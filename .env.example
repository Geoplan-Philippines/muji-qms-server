# --------------------------------------------
# REQUIRED: BASIC APP SETTINGS
# --------------------------------------------
NODE_ENV=production
PORT=8000

# --------------------------------------------
# REQUIRED: DATABASE SETTINGS
# --------------------------------------------
DATABASE_URL=postgresql://postgres:123@localhost:5432/nestjs_postgres_passport?schema=public

# --------------------------------------------
# REQUIRED: AUTH SETTINGS
# --------------------------------------------
JWT_SECRET=replace-with-32-plus-character-secret

# --------------------------------------------
# OPTIONAL: SECURITY HEADER SETTINGS
# --------------------------------------------
# Comma-separated. The frontend is served from a different port on this same
# mini PC, so its origin belongs here — e.g. http://192.168.254.124:4173.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Also accept any private/loopback origin (10.x, 192.168.x, 172.16-31.x,
# 169.254.x, localhost). Keeps the shop working when DHCP moves the mini PC to a
# new address, which would otherwise blank every screen at once. Set to false if
# this box is ever reachable from outside the shop LAN.
CORS_ALLOW_LAN=true

# --------------------------------------------
# OPTIONAL: DATABASE POOL / RESILIENCE
# --------------------------------------------
# Defaults shown. These bound every failure mode that used to need a service
# restart: a pool that waits forever for a connection, or a stuck query that
# holds a slot indefinitely.
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000
DB_RETRY_ATTEMPTS=3
